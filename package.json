  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.26.10",
    "esbuild": "^0.25.1",
    "esbuild-plugin-eslint": "^0.3.12",
    "esbuild-plugin-inline-import": "^1.1.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "postcss": "^8.5.3",
    "postcss-url": "^10.1.3"
  },
  "dependencies": {
    "chalk": "^5.4.1",
    "esbuild-plugin-copy": "^2.1.1",
    "prettier": "^3.5.3"
  }
}
